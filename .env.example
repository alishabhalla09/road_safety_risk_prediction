# RoadGuard AI Environment Configuration

# App Configuration
PROJECT_NAME="RoadGuard AI"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
DATABASE_URL="sqlite:///./roadguard.db"
# POSTGRES_URL="postgresql://roadguard:roadguard_secret@localhost:5432/roadguard_db"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# Model & Storage Paths
MODEL_WEIGHTS_DIR="./data/models"
STORAGE_DIR="./data/storage"
CONFIG_DIR="./configs"

# Privacy & ANPR Options
ANPR_ENABLED=True
MINIMIZE_ANPR_RETENTION=True
ANPR_ACCESS_RESTRICTED=True
